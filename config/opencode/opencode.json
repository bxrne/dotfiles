{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "carpenter-mcp": {
      "command": [
        "/home/bxrne/Development/carpenter/src-tauri/target/debug/carpenter-mcp"
      ],
      "enabled": true,
      "environment": {
        "CARPENTER_MCP_DEBUG": "1",
        "CARPENTER_MCP_LOG": "/home/bxrne/.local/share/com.bxrne.carpenter/logs/carpenter-mcp.log"
      },
      "timeout": 120000,
      "type": "local"
    },
    "charta": {
      "command": [
        "/home/bxrne/Development/charta/target/release/charta"
      ],
      "type": "local"
    },
    "filesystem": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "~/"
      ],
      "type": "local"
    },
    "memory": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "type": "local"
    },
    "sequential-thinking": {
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "type": "local"
    },
    "shadcn": {
      "command": [
        "npx",
        "-y",
        "shadcn@latest",
        "mcp"
      ],
      "type": "local"
    }
  },
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "share": "disabled"
}
