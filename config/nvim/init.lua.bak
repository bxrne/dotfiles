-- Colorscheme (follows the active Omarchy theme: ristretto / monokai-pro)
pcall(function()
	require("monokai-pro").setup({
		filter = "ristretto",
		-- Use the editor background (#2c2525) for sidebars/floats instead of the
		-- darker sideBar shade, so neo-tree/oil/cmp match the rest of the UI.
		background_clear = {"lualine", "bufferline", "neo-tree", "nvim-tree", "telescope", "float_win", "cmp", "renamer" },
		override = function()
			return {
				NonText = { fg = "#948a8b" },
				MiniIconsGrey = { fg = "#948a8b" },
				MiniIconsRed = { fg = "#fd6883" },
				MiniIconsBlue = { fg = "#85dacc" },
				MiniIconsGreen = { fg = "#adda78" },
				MiniIconsYellow = { fg = "#f9cc6c" },
				MiniIconsOrange = { fg = "#f38d70" },
				MiniIconsPurple = { fg = "#a8a9eb" },
				MiniIconsAzure = { fg = "#a8a9eb" },
				MiniIconsCyan = { fg = "#85dacc" },
			}
		end,
	})
	vim.cmd.colorscheme("monokai-pro")
end)

pcall(function()
	require("quicker").setup({
		highlight = {
			enabled = true,
			hlgroup = "Visual",
		},
	})
end)


-- Lualine
pcall(function()
	require("lualine").setup({
		options = {
			theme = "auto",
			globalstatus = true,
			-- Flat separators avoid tall glyphs that can clip or look duplicated
			-- when using adjust-cell-height in the terminal.
			component_separators = { left = '', right = '' },
			section_separators = { left = '', right = '' },
		},
		sections = {
			lualine_a = { "mode" },
			lualine_b = { { "branch", icon = "" }, "filename" },
			lualine_c = {
				{ "diff", symbols = { added = "+", modified = "~", removed = "-" } },
				{ "diagnostics", symbols = { error = "E:", warn = "W:", info = "I:", hint = "H:" } },
			},
			lualine_x = {
				{
					function()
						local clients = vim.lsp.get_clients({ bufnr = 0 })
						if #clients == 0 then return "" end
						local names = {}
						for _, c in ipairs(clients) do table.insert(names, c.name) end
						return table.concat(names, ", ")
					end,
				},
			},
			lualine_y = { "progress" },
			lualine_z = { "filetype" },
		},
	})
end)

